<MudPaper Elevation="0" Class="pa-4 metric-card"
          Style="border-radius: 12px; background: #16213e; border: 1px solid rgba(255,255,255,0.05);">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <MudStack>
            <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.6); text-transform: uppercase; letter-spacing: 0.5px;">
                @Description
            </MudText>
            <MudText Typo="Typo.h4" Style="font-weight:600; color: white;">
                @if (IsLoaded)
                {
                    @($"R {TotalValue:N0}")
                }
                else
                {
                    <MudProgressLinear Color="Color.Default" Indeterminate="true" />
                }
            </MudText>
        </MudStack>
        <MudIcon Icon="@Icons.Material.Filled.TrendingUp" Size="Size.Medium"
                 Style="@($"color: {ComponentColor}; font-size: 42px; opacity: 0.9;")" />
    </MudStack>
</MudPaper>

@code {
    [Parameter]
    public decimal TotalValue { get; set; }

    [Parameter]
    public string Description { get; set; }

    [Parameter]
    public string ComponentColor { get; set; }

    private bool IsLoaded = false;

    protected override void OnParametersSet()
    {
        IsLoaded = true;
    }
}