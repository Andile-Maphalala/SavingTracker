
<MudPaper Elevation="2" Class="pa-4 d-flex flex-column justify-between"
          Style=@($"height: 100px; background:{ComponentColor}; color:white;")>

    <div class="d-flex justify-between align-center">
        <MudText Class="font-weight-bold">@Description @DateTime.Now.ToShortDateString()</MudText>
        <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Large" />
    </div>

    <div class="d-flex justify-end align-center" style="font-size: 3em;">
        @if (IsLoaded)
        {
            <span>@TotalMembers</span>
        }
        else
        {
            <MudProgressLinear Color="Color.Dark" Indeterminate="true" Class="w-1/2" />
        }
    </div>
</MudPaper>

@code {
    [Parameter] 
    public int TotalMembers { get; set; }

    [Parameter] 
    public string Description { get; set; } = "Total Members";

    [Parameter] 
    public string ComponentColor { get; set; } = Colors.Blue.Default;

    private bool IsLoaded = false;

    protected override void OnParametersSet()
    {
        IsLoaded = true;
    }
}
