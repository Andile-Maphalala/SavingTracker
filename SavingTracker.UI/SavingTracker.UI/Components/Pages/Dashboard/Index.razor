 @page "/dashboard";
@page "/";
@attribute [Authorize]

@using SavingTracker.UI.Models.CRUDs
@using SavingTracker.UI.Models.Common
@using SavingTracker.UI.Models.Enums
@using SavingTracker.UI.Models.Lookups
@using SavingTracker.UI.Models.Summary
@using SavingTraker.App.Interfaces
@using Microsoft.AspNetCore.Authorization

@inject IDashboardService service;
@inject IDialogService dialogService
@inject ISavingsPlanService savingPlanService
@inject IContributionTypeService contributionTypeservice
@inject IJSRuntime JSRuntime

<PageTitle>Dashboard</PageTitle>

<MudContainer Class="mt-4 px-4" MaxWidth="MaxWidth.False">

    @* Single date header instead of date on every card *@
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
        <MudText Typo="Typo.h6" Style="font-weight:500;">Dashboard</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">@DateTime.Now.ToLongDateString()</MudText>
    </MudStack>

    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6">
            <AutoSelect TValue="int" Value="SelectedPlanId" Items="SavingPlanList" Label="Savings Plan" For="@(() => SelectedPlanId)" Variant="Variant.Outlined" ValueChanged="OnSavingSelect" Disabled="@DropdownLoading" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <AutoSelect TValue="int" Value="SelectedFreqency" Items="Frequencies" Label="Frequency" For="@(() => SelectedFreqency)" Variant="Variant.Outlined" ValueChanged="OnFrequencySelect" Disabled="@DropdownLoading" />
        </MudItem>

        @if (SelectedPlanId != 0)
        {
            <MudItem xs="12">
                <MudGrid Spacing="2">

                    @if (Loading)
                    {
                        <MudItem xs="12" sm="6" md="4" lg="2">
                            <CardSkeleton />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="2">
                            <CardSkeleton />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="2">
                            <CardSkeleton />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <CardSkeleton />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <CardSkeleton />
                        </MudItem>
                    }
                    else
                    {
                        <MudItem xs="12" sm="6" md="4" lg="2">
                            <TotalNumber Total="Data.TotalMembers" Description="Members" ComponentColor="@Colors.Blue.Default" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="2">
                            <Total TotalValue="Data.TotalContribution" Description="Saved" ComponentColor="@Colors.Green.Default" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="2">
                            <Total TotalValue="Data.TotalOutstandingAmount" Description="Outstanding" ComponentColor="@Colors.Red.Default" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <Total TotalValue="Data.PeriodIncome" Description="@PeriodDescription" ComponentColor="@Colors.Amber.Default" />
                        </MudItem>
                        <MudItem xs="12" sm="6" md="4" lg="3">
                            <TotalNumber Total="Data.TotalPeriods" Description="Periods" ComponentColor="@Colors.Cyan.Default" Icon="@Icons.Material.Filled.CalendarMonth" />
                        </MudItem>
                    }
                </MudGrid>
            </MudItem>
            <MudItem xs="12">
                    @if (IsMobile)
                    {
                        @if (Loading)
                        {
                                <MudItem xs="12" sm="12" md="12" lg="12">
                                    <CardSkeleton />
                                </MudItem>
                        }
                        else
                        {
                            <MobileCardDashboardView Data="Data.MemberSummaries" TotalPeriods="Data.TotalPeriods" />

                        }
                    }
                    else
                    {
                        <div class="responsive-table-container">
                            <AutoTable @ref="tableRef" TItem="MemberDashboardSummaryModel" OnAction="Actions" LoadData="LoadData" ShowAllActionsExceptBulk="false" ActionVisibilities="ActionVisibilities" />
                        </div>
                    }
            </MudItem>
        }
    </MudGrid>
</MudContainer>



@code {
    AutoTable<MemberDashboardSummaryModel> tableRef;

    private DashboardSummaryModel Data = new DashboardSummaryModel();

    private string PeriodDescription { get; set; }

    private List<LookUpModel> SavingPlanList = new List<LookUpModel>();

    private List<LookUpModel> Frequencies = new List<LookUpModel>();

    private int SelectedPlanId { get; set; }

    private int SelectedFreqency { get; set; } = 4;

    private SavingsPlanModel SelectedPlan { get; set; }

    private string FrequencyName { get; set; } = "Monthly";

    private bool DropdownLoading { get; set; } = true;
    private bool Loading { get; set; } = true;
    private bool IsMobile { get; set; } = false;

    private List<AutotableActionVisibilityModel> ActionVisibilities { get; set; } = new List<AutotableActionVisibilityModel>();

    private List<int> LoadingRows { get; } = Enumerable.Range(0, 5).ToList();

    protected override async Task OnInitializedAsync()
    {
        ActionVisibilities.Add(new AutotableActionVisibilityModel { Mode = FormModeEnum.View, IsVisible = true });
        await CheckIfMobile();
        await InvokeAsync(StateHasChanged);
    }


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadDropdownData();
            SelectedPlanId = SavingPlanList.FirstOrDefault()?.Id ?? 0;
            if (SelectedPlanId != 0)
            {
                PeriodDescription = $"{FrequencyName} Expected Income";
            }
            await RefreshDashboard();
            await InvokeAsync(StateHasChanged);
        }
    }
    private async Task Actions(ActionModel<MemberDashboardSummaryModel> item)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parameters = new DialogParameters<MemberDetailDialog>
        {
            { x => x.Data, item.Item.AllContributions },
        };

        var dialog = await dialogService.ShowAsync<MemberDetailDialog>( $" Contributions For {item.Item.MemberName}", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
        }
    }

    private async Task Actions(MemberDashboardSummaryModel item)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parameters = new DialogParameters<MemberDetailDialog>
        {
            { x => x.Data, item.AllContributions },
        };

        var dialog = await dialogService.ShowAsync<MemberDetailDialog>($" Contributions For {item.MemberName}", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
        }
    }

    private async Task<List<MemberDashboardSummaryModel>> LoadData()
    {
        if (SelectedPlanId == 0)
        {
            return new List<MemberDashboardSummaryModel>();
        }
        return Data.MemberSummaries;
    }

    private async Task OnSavingSelect(int value)
    {
        SelectedPlanId = value;
        await RefreshDashboard();
    }

    private async Task OnFrequencySelect(int value)
    {
        SelectedFreqency = value;
        FrequencyName = Frequencies.Where(x => x.Id == value).Select(x => x.Name).FirstOrDefault();
        await RefreshDashboard();    
    }

    private async Task LoadDropdownData()
    {
        var saving = await savingPlanService.GetAll(appCancellation.Token);
        SavingPlanList = saving.Select(x => new LookUpModel { Id = x.Id, Name = x.Name }).ToList();        
        Frequencies = await contributionTypeservice.GetContributionFrequenyList(appCancellation.Token);
        DropdownLoading = false;
    }

    private async Task RefreshDashboard()
    {
        if (SelectedPlanId == 0) return;

        Loading = true;
        await InvokeAsync(StateHasChanged);

        Data = await service.GetDashboardSummary(SelectedPlanId, SelectedFreqency, appCancellation.Token);

        PeriodDescription = $"{FrequencyName} Expected Income";

        Loading = false;
        if(!IsMobile)
        {
            tableRef?.RefreshTable();
        }
        await InvokeAsync(StateHasChanged);
    }
    private async Task CheckIfMobile()
    {
        try
        {
            IsMobile = await JSRuntime.InvokeAsync<bool>("checkIsMobile");
        }
        catch
        {
            // Fallback to checking window width
            IsMobile = await JSRuntime.InvokeAsync<int>("eval", "window.innerWidth") < 641;
        }
    }

}