@using SavingTracker.ApiClient
@using SavingTracker.UI.Models.CRUDs
@using SavingTracker.UI.Models.Enums

@inject IUserService service


<AutoForm TModel="UserPasswordModel" Model="passwordModel" FormMode="FormModeEnum.Update" OnSubmit="Submit" OnCancel="Cancel">
    <MudGrid>
        <MudItem xs="12" sm="12">
            <MudTextField @bind-Value="passwordModel.OldPassword" Label="Old Password" For="@(() => passwordModel.OldPassword)" Variant="Variant.Outlined" InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="TogglePasswordVisibility" AdornmentAriaLabel="Show Password" />
            <MudTextField @bind-Value="passwordModel.NewPassword" Label="New Password" For="@(() => passwordModel.NewPassword)" Variant="Variant.Outlined" InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="TogglePasswordVisibility" AdornmentAriaLabel="Show Password" />
            <MudTextField @bind-Value="passwordModel.ConfirmedPassword" Label="Confirm Password" For="@(() => passwordModel.ConfirmedPassword)" Variant="Variant.Outlined" InputType="@PasswordInput" Adornment="Adornment.End" AdornmentIcon="@PasswordInputIcon" OnAdornmentClick="TogglePasswordVisibility" AdornmentAriaLabel="Show Password" />
        </MudItem>
        <MudItem xs="12" sm="12">
            <MudPaper Width="100%">
                <MudList T="string" ReadOnly="true" Dense="false" Gutters="true" Disabled="true" Padding="false">
                    <MudListSubheader>Password Error</MudListSubheader>
                    @foreach (var error in passwordErrors)
                    {
                        <MudListItem Text="@error" Icon="@Icons.Material.Filled.Error" IconColor="Color.Error" />
                    }
                </MudList>
            </MudPaper>
        </MudItem>
    </MudGrid>
</AutoForm>

@code {

    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    [Parameter]
    public UserDetailsModel Model { get; set; } = new UserDetailsModel();

    private UserPasswordModel passwordModel = new UserPasswordModel();

    private List<string> passwordErrors = new List<string>();

    bool isShow;
    InputType PasswordInput = InputType.Password;
    string PasswordInputIcon = Icons.Material.Filled.VisibilityOff;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        passwordModel.UserId = Model.Id;
    }

    private async Task Submit()
    {
        ValidatePassword();
        if (passwordErrors.Any())
        {
            StateHasChanged();
            return;
        }

        try
        {
            await service.UpdateUserPassword(passwordModel, appCancellation.Token);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (ApiException ex)
        {
            passwordErrors.Add(ex.Response);
        }
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    private void ValidatePassword()
    {
        passwordErrors.Clear();
        if (string.IsNullOrWhiteSpace(passwordModel.OldPassword))
        {
            passwordErrors.Add("Old password is required.");
        }
        if (string.IsNullOrWhiteSpace(passwordModel.NewPassword))
        {
            passwordErrors.Add("New password is required.");
        }
        if (passwordModel.NewPassword != passwordModel.ConfirmedPassword)
        {
            passwordErrors.Add("New password and confirmation do not match.");
        }
        if (!string.IsNullOrWhiteSpace(passwordModel.NewPassword) && passwordModel.NewPassword.Length < 6)
        {
            passwordErrors.Add("New password must be at least 6 characters long.");
        }
        if (passwordModel.OldPassword == passwordModel.NewPassword)
        {
            passwordErrors.Add("New password cannot be the same as the old password.");
        }
    }

    void TogglePasswordVisibility()
    {
        @if (isShow)
        {
            isShow = false;
            PasswordInputIcon = Icons.Material.Filled.VisibilityOff;
            PasswordInput = InputType.Password;
        }
        else
        {
            isShow = true;
            PasswordInputIcon = Icons.Material.Filled.Visibility;
            PasswordInput = InputType.Text;
        }
    }

}
