@page "/contribution";

@using SavingTracker.UI.Components.CustomComponents
@using SavingTracker.UI.Models.CRUDs
@using SavingTracker.UI.Models.Common
@using SavingTracker.UI.Services.Interfaces
@using SavingTraker.App.Interfaces

@inject IDialogService dialogService
@inject IContributionService service

<MudPaper Class="p-4">
    <AutoTable @ref="tableRef" TItem="ContributionModel" OnAction="Actions" LoadData="LoadData" />
</MudPaper>

@code {
    AutoTable<ContributionModel> tableRef;
    private List<ContributionModel> Data = new List<ContributionModel>();
    protected override async Task OnInitializedAsync()
    {

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
        }
    }
    private async Task Actions(ActionModel<ContributionModel> item)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        if (item.Mode == Models.Enums.FormModeEnum.Create)
        {
            item.Item = new ContributionModel();
        }

        var parameters = new DialogParameters<Edit>
        {
            { x => x.Model, item.Item },
            { x => x.FormMode, item.Mode }
        };

        var dialog = await dialogService.ShowAsync<Edit>(item.Mode.ToString(), parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await tableRef?.RefreshTable();
        }
    }

    private async Task<List<ContributionModel>> LoadData()
    {

        Data = await service.GetAll(appCancellation.Token);
        return Data;
    }


}


