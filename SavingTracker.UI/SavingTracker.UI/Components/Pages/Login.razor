@page "/login"
@attribute [AllowAnonymous]
@inject NavigationManager NavManager
@inject IAuthService Auth
@inject AuthenticationStateProvider AuthStateProvider
@inject HttpClient Http
@layout EmptyLayout

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using SavingTracker.UI.Components.Layout

<MudContainer MaxWidth="MaxWidth.ExtraSmall" Class="py-8">
    <MudPaper Class="pa-6" Elevation="3">
        <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">
            Saving Tracker
        </MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Class="mb-6">
            Family Savings Management
        </MudText>

        <EditForm Model="this" OnValidSubmit="OnLogin">
            <DataAnnotationsValidator />

            <MudTextField 
                @bind-Value="Username" 
                Label="Username" 
                Variant="Variant.Outlined"
                Margin="Margin.Normal"
                FullWidth="true"
                Disabled="IsLoading" />

            <MudTextField 
                @bind-Value="Password" 
                Label="Password" 
                InputType="InputType.Password"
                Variant="Variant.Outlined"
                Margin="Margin.Normal"
                FullWidth="true"
                Disabled="IsLoading" />

            @if (!string.IsNullOrEmpty(ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Class="mt-4" Variant="Variant.Filled">
                    @ErrorMessage
                </MudAlert>
            }

            <MudButton 
                ButtonType="ButtonType.Submit" 
                Variant="Variant.Filled" 
                Color="Color.Primary" 
                Size="Size.Large"
                FullWidth="true"
                Class="mt-6"
                Disabled="IsLoading">
                @if (IsLoading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                    <MudText Class="ms-2">Logging in...</MudText>
                }
                else
                {
                    <MudText>Login</MudText>
                }
            </MudButton>
        </EditForm>
    </MudPaper>
</MudContainer>

@code {
    private string Username = "";
    private string Password = "";
    private string ErrorMessage = "";
    private bool IsLoading = false;

    private async Task OnLogin()
    {
        ErrorMessage = "";
        IsLoading = true;

        try
        {
            // Just validate locally first if needed, then redirect to login API
            if (string.IsNullOrEmpty(Username) || string.IsNullOrEmpty(Password))
            {
                ErrorMessage = "Username and password are required.";
                IsLoading = false;
                return;
            }

            // Direct redirect to the login API with both username and password
            var returnUrl = "/"; // or get from query string if you have one

            NavManager.NavigateTo(
                        $"/api/account/login?username={Uri.EscapeDataString(Username)}&password={Uri.EscapeDataString(Password)}&returnUrl={Uri.EscapeDataString(returnUrl)}",
                        forceLoad: true);
        }
        catch (Exception ex)
        {
            ErrorMessage = "An error occurred. Please try again.";
            Console.Error.WriteLine($"Login error: {ex.Message}");
            IsLoading = false;
        }
    }
}
