@using SavingTracker.UI.Components.CustomComponents
@using SavingTracker.UI.Models.CRUDs

@page "/savingsplans";
@inject IDialogService dialogService;

<MudPaper Class="p-4">
    <AutoTable TItem="SavingsPlanModel" Items="Data" OnEdit="Edit"/>
</MudPaper>

@code {

    private List<SavingsPlanModel> Data = new List<SavingsPlanModel>();

    protected override async Task OnInitializedAsync()
    {
        Data = new List<SavingsPlanModel>
        {
            new SavingsPlanModel { Id = 1, Name = "Retirement Fund", TargetAmount = 100000, StartDate = new DateTime(2020, 1, 1), EndDate = new DateTime(2040, 1, 1) },
            new SavingsPlanModel { Id = 2, Name = "Vacation Fund", TargetAmount = 5000,  StartDate = new DateTime(2023, 6, 1), EndDate = new DateTime(2024, 6, 1) },
            new SavingsPlanModel { Id = 3, Name = "Emergency Fund", TargetAmount = 20000, StartDate = new DateTime(2021, 3, 15), EndDate = new DateTime(2023, 3, 15) }
        };


    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
        }
    }
    private async Task Edit(SavingsPlanModel item)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var dialog = await dialogService.ShowAsync<Edit>("Simple Dialog", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            
        }
    }


}


