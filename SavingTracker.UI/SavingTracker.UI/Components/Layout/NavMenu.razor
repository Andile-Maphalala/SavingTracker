@using Microsoft.AspNetCore.Components.Authorization
@inject IAuthService AuthService
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime

<div class="sidebar-brand">
    <MudIcon Icon="@Icons.Material.Filled.Savings" Style="color: #97C459; font-size: 20px;" />
    <MudText Typo="Typo.subtitle2" Style="color: rgba(255,255,255,0.9); font-weight:500; letter-spacing:0.01em;">SaveTracker</MudText>
</div>

<input type="checkbox" id="nav-toggler" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable">
    <nav class="flex-column">
        <MudText Class="nav-section-label">Menu</MudText>
        <div class="nav-item px-2">
            <AuthorizeView>
                <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All" @onclick="CloseMenuOnMobile">
                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Class="nav-icon" />
                    Dashboard
                </NavLink>
                <NavLink class="nav-link" href="/contribution" @onclick="CloseMenuOnMobile">
                    <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Class="nav-icon" />
                    Contributions
                </NavLink>
                <NavLink class="nav-link" href="/contributiontype" @onclick="CloseMenuOnMobile">
                    <MudIcon Icon="@Icons.Material.Filled.Category" Class="nav-icon" />
                    Contribution type
                </NavLink>
            </AuthorizeView>
        </div>

        <AuthorizeView Roles="Admin">
            <div class="nav-divider"></div>
            <MudText Class="nav-section-label">Admin</MudText>
            <div class="nav-item px-2">
                <NavLink class="nav-link" href="/savingsplans" @onclick="CloseMenuOnMobile">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalanceWallet" Class="nav-icon" />
                    Savings plan
                </NavLink>
                <NavLink class="nav-link" href="/members" @onclick="CloseMenuOnMobile">
                    <MudIcon Icon="@Icons.Material.Filled.Group" Class="nav-icon" />
                    Members
                </NavLink>
                <NavLink class="nav-link" href="/users" @onclick="CloseMenuOnMobile">
                    <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Class="nav-icon" />
                    Users
                </NavLink>
            </div>
        </AuthorizeView>
    </nav>

    <div class="nav-bottom">
        <div class="nav-divider"></div>
        <AuthorizeView>
            <Authorized>
                <div class="nav-user-row">
                    <MudAvatar Color="Color.Dark" Size="Size.Small" Style="font-size:11px; width:28px; height:28px;">
                        @(context.User.Identity?.Name?.Substring(0, 2).ToUpper() ?? "??")
                    </MudAvatar>
                    <MudText Typo="Typo.caption" Style="color: rgba(255,255,255,0.55); flex:1;">
                        @context.User.Identity?.Name
                    </MudText>
                    <MudTooltip Text="Logout">
                        <MudIconButton Icon="@Icons.Material.Filled.Logout"
                                       Size="Size.Small"
                                       Style="color: rgba(255,255,255,0.35);"
                                       OnClick="Logout" />
                    </MudTooltip>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

@code {

    private void Login() => NavManager.NavigateTo("/login");

    private async Task Logout()
    {
        await AuthService.LogoutAsync(appCancellation.Token);

        try
        {
            NavManager.NavigateTo("/logout", true);
        }
        catch (TaskCanceledException)
        {
            // Expected when navigation cancels the operation
        }
        catch (JSDisconnectedException)
        {
            // Handle JS disconnect gracefully
        }
        catch
        {
            // Log other exceptions as needed
        }
    }

    private async Task CloseMenuOnMobile()
    {
        await JSRuntime.InvokeVoidAsync("closeMenuOnMobile");
    }

}

<script>
    window.initNavToggle = function() {
        // Get elements
        var toggler = document.getElementById('nav-toggler');
        var navScrollable = document.querySelector('.nav-scrollable');

        if (!toggler || !navScrollable) return;

        // Function to handle responsive behavior
        function handleResize() {
            var isMobile = window.innerWidth < 641;

            if (!isMobile) {
                // On desktop, always show menu and uncheck toggler
                navScrollable.style.display = 'flex';
                if (toggler.checked) toggler.checked = false;
            } else {
                // On mobile, respect checkbox state
                if (!toggler.checked) {
                    navScrollable.style.display = 'none';
                } else {
                    navScrollable.style.display = 'flex';
                }
            }
        }

        // Handle checkbox change
        toggler.addEventListener('change', function(e) {
            if (window.innerWidth < 641) {
                navScrollable.style.display = this.checked ? 'flex' : 'none';
            }
        });

        // Handle window resize
        window.addEventListener('resize', handleResize);

        // Initial call
        handleResize();
    };

    window.closeMenuOnMobile = function() {
        var toggler = document.getElementById('nav-toggler');
        var navScrollable = document.querySelector('.nav-scrollable');

        if (window.innerWidth < 641 && toggler && toggler.checked) {
            toggler.checked = false;
            navScrollable.style.display = 'none';
        }
    };

    // Initialize when DOM is ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', window.initNavToggle);
    } else {
        window.initNavToggle();
    }
</script>