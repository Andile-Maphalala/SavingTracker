@using SavingTracker.UI.Services
@inject AuthService Auth
@inject NavigationManager NavManager



<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid d-flex justify-content-between align-items-center">
        @if (Auth.IsLoggedIn)
        {
            <MudButton Color="Color.Secondary" Variant="Variant.Outlined" OnClick="Logout">
                Logout (@Auth.CurrentUser)
            </MudButton>
        }
        else
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Login">
                Login
            </MudButton>
        }
    </div>
</div>
<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
            <NavLink class="nav-link" href="/savingsplans" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> SavingsPlan
            </NavLink>
            <NavLink class="nav-link" href="/members" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Member
            </NavLink>
            <NavLink class="nav-link" href="/contribution" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Contributions
            </NavLink>
            <NavLink class="nav-link" href="/contributiontype" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> ContributionType
            </NavLink>


        </div>
    </nav>
</div>

@code {
    private void Login()
    {
        NavManager.NavigateTo("/login");
    }

    private void Logout()
    {
        Auth.Logout();
        NavManager.NavigateTo("/", true);
    }
}