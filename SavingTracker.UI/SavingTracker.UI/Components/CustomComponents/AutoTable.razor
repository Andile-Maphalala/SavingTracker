@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using MudBlazor
@typeparam TItem

<MudTable Items="Items"
          Dense="Dense"
          Hover="Hover"
          Bordered="Bordered"
          Striped="Striped"
          Filter="DynamicFilter">
    <HeaderContent>
        @foreach (var column in VisibleColumns)
        {
            <MudTh>@column.DisplayName</MudTh>
        }
    </HeaderContent>
    <ToolBarContent>
        <MudGrid>
            <MudItem xs="12" sm="9">
                @if (OnAdd.HasDelegate)
                {
                    <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" Color="Color.Info" OnClick="OnAdd">Add</MudButton>
                }
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudTextField @bind-Value="searchString" Placeholder="Search" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </MudItem>
        </MudGrid>
            
    </ToolBarContent>
    <RowTemplate>
        @foreach (var column in VisibleColumns)
        {
            <MudTd>@(column.PropertyInfo.GetValue(context))</MudTd>
        }
        @if (CrudColumn != null)
        {
            @foreach (var c in CrudColumn)
            {
                <MudTd>@c(context)</MudTd>
            }
        }
    </RowTemplate>
</MudTable>

@code {
    [Parameter] public IEnumerable<TItem>? Items { get; set; }

    [Parameter] 
    public bool Dense { get; set; } = true;
    [Parameter] 
    public bool Hover { get; set; } = true;
    [Parameter] 
    public bool Bordered { get; set; } = true;
    [Parameter] 
    public bool Striped { get; set; } = true;
    [Parameter] 
    public EventCallback<TItem> OnEdit { get; set; }
    [Parameter] 
    public EventCallback<TItem> OnView { get; set; }
    [Parameter] 
    public EventCallback OnAdd{ get; set; }
    [Parameter] 
    public EventCallback<TItem> OnDelete { get; set; }


    private string searchString { get; set; } = string.Empty;

    private List<PropertyInfo> SearchableProps = new();
    private List<ColumnDefinition> VisibleColumns = new();
    private List<RenderFragment<TItem>> CrudColumn { get; set; } = default!;


    protected override void OnInitialized()
    {
        // Reflect model properties
        VisibleColumns = typeof(TItem)
            .GetProperties(BindingFlags.Public | BindingFlags.Instance)
            .Select(p => new ColumnDefinition(p))
            .Where(c => c.Visible)
            .OrderBy(c => c.Order)
            .ToList();

        SearchableProps = VisibleColumns
            .Where(c =>
                c.PropertyInfo.PropertyType.IsPrimitive ||
                c.PropertyInfo.PropertyType == typeof(string) ||
                c.PropertyInfo.PropertyType == typeof(decimal) ||
                c.PropertyInfo.PropertyType == typeof(DateTime))
            .Select(c => c.PropertyInfo)
            .ToList();

        AddCrudColumnButtons();
    }

    private bool DynamicFilter(TItem item)
    {
        if (string.IsNullOrWhiteSpace(searchString))
            return true;

        var search = searchString.Trim();

        foreach (var prop in SearchableProps)
        {
            var value = prop.GetValue(item)?.ToString();
            if (!string.IsNullOrEmpty(value) &&
                value.Contains(search, StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }
        }

        return false;
    }

    private class ColumnDefinition
    {
        public PropertyInfo PropertyInfo { get; }
        public string DisplayName { get; }
        public int Order { get; }
        public bool Visible { get; }

        public ColumnDefinition(PropertyInfo property)
        {
            PropertyInfo = property;

            var displayAttr = property.GetCustomAttribute<DisplayAttribute>();
            var scaffoldAttr = property.GetCustomAttribute<ScaffoldColumnAttribute>();

            DisplayName = displayAttr?.Name ?? property.Name;
            Order = displayAttr?.GetOrder() ?? 0;
            Visible = scaffoldAttr?.Scaffold ?? true;
        }
    }

    private void AddCrudColumnButtons()
    {
        var crudColumns = new List<RenderFragment<TItem>>();
        if (OnView.HasDelegate)
        {
            crudColumns.Add(item => builder =>
            {
                builder.OpenComponent<MudButton>(0);
                builder.AddAttribute(1, "Color", Color.Info);
                builder.AddAttribute(2, "Variant", Variant.Filled);
                builder.AddAttribute(3, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, () => OnView.InvokeAsync(item)));
                builder.AddAttribute(4, "StartIcon", Icons.Material.Filled.Visibility);
                builder.AddAttribute(5, "ChildContent", (RenderFragment)(b =>
                {
                    b.AddContent(6, "View");
                }));
                builder.CloseComponent();
            });
        }
        if (OnEdit.HasDelegate)
        {
            crudColumns.Add(item => builder =>
            {
                builder.OpenComponent<MudButton>(0);
                builder.AddAttribute(1, "Color", Color.Primary);
                builder.AddAttribute(2, "Variant", Variant.Filled);
                builder.AddAttribute(3, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, (MouseEventArgs e) => OnEdit.InvokeAsync(item)));
                builder.AddAttribute(4, "StartIcon", Icons.Material.Filled.Edit);
                builder.AddAttribute(5, "ChildContent", (RenderFragment)(b =>
                {
                    b.AddContent(6, "Edit");
                }));
                builder.CloseComponent();
            });
        }
        if (OnDelete.HasDelegate)
        {
            crudColumns.Add(item => builder =>
            {
                builder.OpenComponent<MudButton>(0);
                builder.AddAttribute(1, "Color", Color.Error);
                builder.AddAttribute(2, "Variant", Variant.Filled);
                builder.AddAttribute(3, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, () => OnDelete.InvokeAsync(item)));
                builder.AddAttribute(4, "StartIcon", Icons.Material.Filled.Delete);
                builder.AddAttribute(5, "ChildContent", (RenderFragment)(b =>
                {
                    b.AddContent(6, "Delete");
                }));
                builder.CloseComponent();
            });
        }
        CrudColumn = crudColumns;

    }

}
